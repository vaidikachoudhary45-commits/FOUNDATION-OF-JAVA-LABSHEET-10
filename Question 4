import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

class Q4 extends JFrame implements ActionListener {
    JTextField a, b, c, d, e;
    JButton btn;
    JLabel result;

    Q4() {
        setLayout(new GridLayout(7, 2));

        add(new JLabel("English:"));
        a = new JTextField(); add(a);

        add(new JLabel("Mathematics:"));
        b = new JTextField(); add(b);

        add(new JLabel("Java:"));
        c = new JTextField(); add(c);

        add(new JLabel("DBMS:"));
        d = new JTextField(); add(d);

        add(new JLabel("Computer Networks:"));
        e = new JTextField(); add(e);

        btn = new JButton("Calculate Result");
        add(btn);

        result = new JLabel();
        add(result);

        btn.addActionListener(this);

        setSize(350, 300);
        setTitle("Student Marksheet");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setVisible(true);
    }

    public void actionPerformed(ActionEvent x) {
        int total = Integer.parseInt(a.getText())
                  + Integer.parseInt(b.getText())
                  + Integer.parseInt(c.getText())
                  + Integer.parseInt(d.getText())
                  + Integer.parseInt(e.getText());

        double per = total / 5.0;
        String grade = per >= 90 ? "A+" :
                       per >= 75 ? "A" :
                       per >= 60 ? "B" :
                       per >= 40 ? "C" : "F";

        String status = per >= 40 ? "Pass" : "Fail";

        result.setText("<html>Total: " + total +
            "<br>Percentage: " + per +
            "%<br>Grade: " + grade +
            "<br>Status: " + status + "</html>");
    }

    public static void main(String[] args) {
        new Q4();
    }
}
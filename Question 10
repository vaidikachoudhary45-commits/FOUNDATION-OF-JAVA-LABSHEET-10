import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

class Q10 extends JFrame implements ActionListener {
    JTextField acc, name, balance, amount;
    JButton deposit, withdraw, check, clear;
    double bal = 5000;

    Q10() {
        setLayout(new FlowLayout());

        add(new JLabel("Account Number:"));
        acc = new JTextField(12); add(acc);

        add(new JLabel("Customer Name:"));
        name = new JTextField(12); add(name);

        add(new JLabel("Current Balance:"));
        balance = new JTextField("5000", 12);
        balance.setEditable(false);
        add(balance);

        add(new JLabel("Amount:"));
        amount = new JTextField(12); add(amount);

        deposit = new JButton("Deposit");
        withdraw = new JButton("Withdraw");
        check = new JButton("Check Balance");
        clear = new JButton("Clear");

        add(deposit);
        add(withdraw);
        add(check);
        add(clear);

        deposit.addActionListener(this);
        withdraw.addActionListener(this);
        check.addActionListener(this);
        clear.addActionListener(this);

        setSize(350, 300);
        setTitle("Mini Banking System");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {
        if(e.getSource() == clear) {
            acc.setText("");
            name.setText("");
            amount.setText("");
            return;
        }

        if(e.getSource() == check) {
            JOptionPane.showMessageDialog(this,
                "Current Balance: " + bal);
            return;
        }

        try {
            double a = Double.parseDouble(amount.getText());

            if(a <= 0) {
                JOptionPane.showMessageDialog(this,
                    "Enter a valid amount");
                return;
            }

            if(e.getSource() == deposit) {
                bal += a;
                JOptionPane.showMessageDialog(this,
                    "Amount Deposited Successfully");
            }

            if(e.getSource() == withdraw) {
                if(a <= bal) {
                    bal -= a;
                    JOptionPane.showMessageDialog(this,
                        "Withdrawal Successful");
                } else {
                    JOptionPane.showMessageDialog(this,
                        "Insufficient Balance");
                }
            }

            balance.setText(String.valueOf(bal));

        } catch(NumberFormatException ex) {
            JOptionPane.showMessageDialog(this,
                "Enter a valid amount");
        }
    }

    public static void main(String[] args) {
        new Q10();
    }
}